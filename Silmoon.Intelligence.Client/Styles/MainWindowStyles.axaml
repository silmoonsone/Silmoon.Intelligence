<Styles xmlns="https://github.com/avaloniaui">
  <Style Selector="TextBlock">
    <Setter Property="FontFamily" Value="Inter, Microsoft YaHei UI, Microsoft YaHei" />
    <Setter Property="Foreground" Value="#273142" />
  </Style>
  <Style Selector="Button">
    <Setter Property="FontFamily" Value="Inter, Microsoft YaHei UI, Microsoft YaHei" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="#273142" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="#748094" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="#8B95A6" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="White" />
    <Setter Property="BorderBrush" Value="#E2E6ED" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Border.sidebarItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Margin" Value="0,2" />
  </Style>
  <Style Selector="Button.sessionButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.sessionButton:pointerover">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.sessionButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox#SessionsHost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox#SessionsHost /template/ ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox#SessionsHost /template/ Border">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="ListBox#SessionsHost ListBoxItem /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBoxItem:pointerover Border.sidebarItem">
    <Setter Property="Background" Value="#1C2638" />
  </Style>
  <Style Selector="ListBoxItem:selected Border.sidebarItem">
    <Setter Property="Background" Value="#263247" />
  </Style>
  <Style Selector="Border.sidebarItem.selected">
    <Setter Property="Background" Value="#263247" />
  </Style>
  <Style Selector="ListBoxItem:selected TextBlock.sessionTitle">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="ListBoxItem:selected TextBlock.sessionMeta">
    <Setter Property="Foreground" Value="#B8C1D1" />
  </Style>
  <Style Selector="Border.sidebarItem.selected TextBlock.sessionTitle">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Border.sidebarItem.selected TextBlock.sessionMeta">
    <Setter Property="Foreground" Value="#B8C1D1" />
  </Style>
  <Style Selector="TextBox.chatInput">
    <Setter Property="Background" Value="White" />
    <Setter Property="Foreground" Value="#202938" />
    <Setter Property="CaretBrush" Value="#202938" />
    <Setter Property="SelectionBrush" Value="#BFD7FF" />
    <Setter Property="BorderBrush" Value="#C9D3E4" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="LineHeight" Value="20" />
  </Style>
  <Style Selector="TextBox.chatInput:pointerover">
    <Setter Property="Background" Value="White" />
    <Setter Property="Foreground" Value="#202938" />
    <Setter Property="BorderBrush" Value="#AAB8CC" />
  </Style>
  <Style Selector="TextBox.chatInput:focus">
    <Setter Property="Background" Value="White" />
    <Setter Property="Foreground" Value="#202938" />
    <Setter Property="BorderBrush" Value="#5B6FF0" />
  </Style>
  <Style Selector="TextBox.chatInput:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="White" />
  </Style>
  <Style Selector="TextBox.chatInput:focus /template/ ContentPresenter">
    <Setter Property="Background" Value="White" />
  </Style>
  <Style Selector="Button.sendButton">
    <Setter Property="Background" Value="#5B6FF0" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.sendButton /template/ ContentPresenter">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.sendButton:disabled">
    <Setter Property="Background" Value="#D3DAE8" />
    <Setter Property="Foreground" Value="#6F7A8C" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Button.sendButton:disabled /template/ ContentPresenter">
    <Setter Property="Background" Value="#D3DAE8" />
    <Setter Property="Foreground" Value="#6F7A8C" />
    <Setter Property="Opacity" Value="1" />
  </Style>
  <Style Selector="Border.markdownSurface">
    <Setter Property="Background" Value="#FFFFFF" />
    <Setter Property="BorderBrush" Value="#DDE4EE" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10" />
  </Style>
  <Style Selector="ProgressBar.activityBar">
    <Setter Property="Background" Value="#E7ECF5" />
    <Setter Property="Foreground" Value="#5B6FF0" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
  <Style Selector="ProgressBar.toolActivityBar">
    <Setter Property="Background" Value="#EEF2F8" />
    <Setter Property="Foreground" Value="#5B6FF0" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>
</Styles>
