<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Silmoon.Intelligence.MauiClient.Pages.Chat"
             xmlns:page="clr-namespace:Silmoon.Intelligence.MauiClient.Pages"
             x:DataType="page:ChatViewModel"
             Title="Chat">
    <StackLayout VerticalOptions="Fill">
        <ScrollView HeightRequest="600">
            <Label Text="{Binding Output}"></Label>
        </ScrollView>
        <StackLayout Orientation="Horizontal">
            <Entry Text="{Binding Input}" HorizontalOptions="FillAndExpand"></Entry>
            <Button Text="发送" Command="{Binding ChatCommand}"></Button>
        </StackLayout>
    </StackLayout>
</ContentPage>